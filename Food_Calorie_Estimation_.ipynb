
# Scatter Plot with 5 Clusters

import matplotlib.pyplot as plt
import numpy as np

np.random.seed(42)

# Generate cluster data
cluster1 = np.random.normal([30, 82], [6, 10], (50, 2))
cluster2 = np.random.normal([32, 28], [7, 10], (50, 2))
cluster3 = np.random.normal([60, 60], [7, 10], (50, 2))
cluster4 = np.random.normal([87, 83], [7, 10], (50, 2))
cluster5 = np.random.normal([90, 30], [7, 10], (50, 2))

# Plot clusters
plt.figure(figsize=(10, 6))

plt.scatter(cluster1[:,0], cluster1[:,1], color='blue', marker='o', label='Cluster 1')
plt.scatter(cluster2[:,0], cluster2[:,1], color='orange', marker='^', label='Cluster 2')
plt.scatter(cluster3[:,0], cluster3[:,1], color='green', marker='s', label='Cluster 3')
plt.scatter(cluster4[:,0], cluster4[:,1], color='purple', marker='d', label='Cluster 4')
plt.scatter(cluster5[:,0], cluster5[:,1], color='red', marker='*', label='Cluster 5')

# Mark cluster centres
centres = [[30,82], [32,28], [60,60], [87,83], [90,30]]

for x, y in centres:
    plt.scatter(x, y, color='black', marker='*', s=180)

# Labels and title
plt.xlabel('Annual Income (k$)')
plt.ylabel('Spending Score (1-100)')
plt.title('Customer Segmentation using Clustering')

plt.legend()
plt.grid(False)
plt.show()
